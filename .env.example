# Copy to .env (gitignored) for local runs: pip install -r requirements.txt && flask --app app run
# On Render: set the same keys under your web service → Environment.

# --- Resend (recommended): https://resend.com — sign up, add & verify your domain,
# then create an API key. The app uses Resend when RCD_RESEND_API_KEY is set.
RCD_RESEND_API_KEY=
# Must be a sender Resend accepts for your account (verified domain), e.g.:
#   RCD_EMAIL_FROM="River City Doubles <noreply@yourdomain.com>"
# or: RCD_EMAIL_FROM=noreply@yourdomain.com
RCD_EMAIL_FROM=

# --- Brevo HTTP API (recommended on Render; faster than SMTP relay):
# Create under Brevo → SMTP & API → API keys & MCP (not the SMTP key).
# RCD_BREVO_API_KEY=

# --- Alternative: SMTP (leave RCD_RESEND_API_KEY unset; if both are set, Resend wins).

# Brevo — https://www.brevo.com → Transactional → SMTP & API → generate SMTP key.
# Verify your sender in Brevo (Settings → Senders, domains & IPs → Senders, or app.brevo.com/senders/list).
# RCD_EMAIL_FROM must match a verified sender (or a domain you authenticated under Domains).
# RCD_SMTP_HOST=smtp-relay.brevo.com
# RCD_SMTP_PORT=587
# RCD_SMTP_USER=your-brevo-smtp-login-email
# RCD_SMTP_PASS=your-brevo-smtp-key
# RCD_EMAIL_FROM=noreply@yourdomain.com
# RCD_EMAIL_FROM_NAME=River City Doubles
# Port 465 with implicit TLS: RCD_SMTP_PORT=465 and RCD_SMTP_SSL=1

# SendGrid (SMTP user is literally "apikey", password is the API key):
# RCD_SMTP_HOST=smtp.sendgrid.net
# RCD_SMTP_PORT=587
# RCD_SMTP_USER=apikey
# RCD_SMTP_PASS=

# Optional: same value on server + GitHub secret for daily POST /api/cron/notifications
# RCD_CRON_SECRET=

# Optional: enables POST /api/notifications/test-email with JSON {"secret":"...","to":"..."}
# RCD_NOTIFICATION_TEST_SECRET=
